# Local dev reads docker-compose.dev.yml (filled by scripts/dev_snapshot.py), never Neon: each wake
# bills Neon Free at least 5 min. Scripts that must write production take it explicitly:
#   DATABASE_URL=$PROD_DATABASE_URL python scripts/backfill_openf1.py ...
DATABASE_URL=postgresql://f1:f1@localhost:5435/f1_dev
PROD_DATABASE_URL=postgresql://user:password@ep-xxx-pooler.neon.tech/neondb?sslmode=require
DASHBOARD_USER=admin
DASHBOARD_PASSWORD=
# Optional: scripts/neon_usage.py
NEON_API_KEY=
NEON_PROJECT_ID=
