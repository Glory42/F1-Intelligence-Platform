---
interface Props {
  items: Array<{ label: string; value: string | number }>;
  cols?: string;
}

const { items, cols = 'grid-cols-2 sm:grid-cols-4' } = Astro.props;
---

<div class={`grid ${cols} gap-px bg-white/[0.06]`}>
  {items.map(({ label, value }) => (
    <div class="bg-black p-4">
      <div class="font-mono text-[8px] text-muted-foreground tracking-widest uppercase mb-1">{label}</div>
      <div class="font-bold text-xl">{value}</div>
    </div>
  ))}
</div>
