---
// A season menu where each entry has its own href (driver/team pages, where the id changes per year).
interface Props {
  items: { year: number; href: string }[];
  currentYear: number;
}
const { items, currentYear } = Astro.props;
---

<div class="relative" data-year-select>
  <button
    type="button"
    data-year-select-button
    aria-haspopup="true"
    aria-expanded="false"
    aria-label={`Season ${currentYear}: choose another`}
    class="flex items-center gap-2 font-mono text-[9px] tracking-[0.12em] uppercase px-3 py-1.5 border border-[rgba(168,85,247,0.5)] text-[#a855f7] bg-[rgba(168,85,247,0.08)] hover:bg-[rgba(168,85,247,0.14)] transition-colors duration-150 focus:outline-none"
  >
    {currentYear}
    <span data-year-select-arrow class="text-[8px] transition-transform duration-150">▾</span>
  </button>

  <!-- 6 rows visible, the rest scroll -->
  <div
    data-year-select-panel
    class="absolute right-0 top-full mt-1 z-50 hidden border border-[rgba(168,85,247,0.25)] bg-[#080808] min-w-[80px]"
    style="max-height: calc(6 * 34px); overflow-y: auto;"
  >
    {items.map((item) => (
      <a
        href={item.href}
        aria-current={item.year === currentYear ? 'page' : undefined}
        class={`block px-4 py-2 font-mono text-[9px] tracking-[0.12em] uppercase transition-colors duration-100 ${
          item.year === currentYear
            ? 'text-[#a855f7] bg-[rgba(168,85,247,0.12)]'
            : 'text-muted-foreground hover:text-foreground hover:bg-white/[0.04]'
        }`}
      >
        {item.year}
      </a>
    ))}
  </div>
</div>

<script>
  import { initYearSelects } from '@/lib/yearSelectMenu';

  document.addEventListener('astro:page-load', () => initYearSelects());
</script>
