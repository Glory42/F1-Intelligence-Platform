---
import YearSelectLinks from './YearSelectLinks.astro';

interface Props {
  years: { year: number; raceCount: number }[];
  currentYear: number;
  basePath?: string;
  extraParams?: string;
  /** Builds each season's link itself, e.g. via seasonTabHref so the open tab is kept. */
  hrefFor?: (year: number) => string;
}
const { years, currentYear, basePath = '', extraParams = '', hrefFor = (y: number) => `${basePath}?year=${y}${extraParams}` } = Astro.props;
const items = years.filter((y) => y.raceCount > 0).map((y) => ({ year: y.year, href: hrefFor(y.year) }));
---

<YearSelectLinks items={items} currentYear={currentYear} />
