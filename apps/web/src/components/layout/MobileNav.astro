---
import { Menu, Search, X } from 'lucide-react';
import SiteLogo from './SiteLogo.astro';
import NavGroups from './NavGroups.astro';
import { activeDestination, buildNavGroups, buildNavUtilities } from './navLinks';

const groups = buildNavGroups();
const utilities = buildNavUtilities(import.meta.env.DEV);
const active = activeDestination(groups, Astro.url.pathname);
---

<header class="glass md:hidden fixed top-0 inset-x-0 z-40 flex h-12 items-center justify-between border-b border-white/[0.06] px-5">
  <div class="flex items-center gap-3">
    <button
      id="mobile-menu-toggle"
      type="button"
      class="press text-muted-foreground hover:text-foreground focus:outline-none"
      aria-label="Open menu"
      aria-expanded="false"
      aria-controls="mobile-sidebar"
    >
      <Menu size={18} />
    </button>
    <a href="/" class="flex items-center gap-2">
      <SiteLogo />
      <span class="font-mono text-[9px] tracking-[0.18em] uppercase text-muted-foreground">f1 intelligence</span>
    </a>
  </div>
  <button
    type="button"
    onclick="window.dispatchEvent(new Event('open-global-search'))"
    aria-label="Search"
    class="press text-muted-foreground hover:text-foreground focus:outline-none"
  >
    <Search size={16} />
  </button>
</header>

<!-- `invisible` once closed: an off-screen transform alone still leaves the drawer focusable and "visible". -->
<div
  id="mobile-sidebar"
  class="glass-heavy md:hidden invisible fixed inset-y-0 left-0 z-50 flex w-[260px] flex-col border-r border-white/[0.08] -translate-x-full transition-[transform,visibility] duration-300 ease-spring"
  role="dialog"
  aria-modal="true"
  aria-label="Navigation menu"
  tabindex="-1"
>
  <div class="flex h-12 shrink-0 items-center justify-between border-b border-white/[0.06] px-5">
    <span class="font-mono text-[9px] tracking-[0.25em] uppercase" style="color: rgba(168,85,247,0.55)">./menu</span>
    <button id="mobile-sidebar-close" type="button" class="press text-muted-foreground hover:text-foreground focus:outline-none" aria-label="Close menu">
      <X size={16} />
    </button>
  </div>

  <nav aria-label="Site" class="flex-1 overflow-y-auto px-2 py-5">
    <NavGroups groups={groups} activeHref={active?.href} />
  </nav>

  <div class="flex flex-col gap-0.5 border-t border-white/[0.06] px-2 py-3">
    {utilities.map(({ href, label, icon: Icon }) => (
      <a href={href} class="flex h-9 items-center gap-3 rounded-md px-3 text-[13px] capitalize text-muted-foreground hover:text-foreground transition-colors duration-150">
        <Icon size={14} />
        {label}
      </a>
    ))}
  </div>
</div>

<div id="mobile-sidebar-backdrop" class="md:hidden fixed inset-0 z-[45] hidden bg-black/60 backdrop-blur-sm opacity-0 transition-opacity duration-300" />

<script>
  function initMobileMenu() {
    const toggleBtn = document.getElementById('mobile-menu-toggle');
    const closeBtn = document.getElementById('mobile-sidebar-close');
    const sidebar = document.getElementById('mobile-sidebar');
    const backdrop = document.getElementById('mobile-sidebar-backdrop');

    if (!toggleBtn || !sidebar || !backdrop) return;

    const getFocusable = (): HTMLElement[] =>
      Array.from(sidebar!.querySelectorAll<HTMLElement>('a[href], button:not([disabled])'));

    function trapFocus(e: KeyboardEvent) {
      if (e.key === 'Escape') return closeMenu();
      if (e.key !== 'Tab') return;
      const focusable = getFocusable();
      if (focusable.length === 0) return;
      const first = focusable[0];
      const last = focusable[focusable.length - 1];
      if (e.shiftKey && document.activeElement === first) {
        e.preventDefault();
        last.focus();
      } else if (!e.shiftKey && document.activeElement === last) {
        e.preventDefault();
        first.focus();
      }
    }

    function openMenu() {
      sidebar!.classList.remove('-translate-x-full', 'invisible');
      backdrop!.classList.remove('hidden');
      toggleBtn!.setAttribute('aria-expanded', 'true');
      setTimeout(() => backdrop!.classList.add('opacity-100'), 10);
      document.addEventListener('keydown', trapFocus);
      (getFocusable()[0] ?? sidebar!).focus();
    }

    function closeMenu() {
      sidebar!.classList.add('-translate-x-full', 'invisible');
      backdrop!.classList.remove('opacity-100');
      toggleBtn!.setAttribute('aria-expanded', 'false');
      document.removeEventListener('keydown', trapFocus);
      setTimeout(() => backdrop!.classList.add('hidden'), 300);
      toggleBtn!.focus();
    }

    toggleBtn.addEventListener('click', openMenu);
    closeBtn?.addEventListener('click', closeMenu);
    backdrop.addEventListener('click', closeMenu);
  }

  document.addEventListener('astro:page-load', initMobileMenu);
</script>
