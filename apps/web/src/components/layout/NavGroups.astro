---
import type { NavGroup } from './navLinks';

interface Props {
  groups: NavGroup[];
  activeHref: string | undefined;
}

const { groups, activeHref } = Astro.props;
---

<div class="flex flex-col gap-5">
  {groups.map((group, i) => (
    <div>
      <p class="sidebar-label px-3 mb-1.5 font-mono text-[9px] tracking-[0.25em] uppercase" style="color: rgba(168,85,247,0.55)">
        ./{group.label}
      </p>
      {i > 0 && <div class="sidebar-collapsed-only mx-3 mb-3 h-px bg-white/[0.06]" />}
      <ul aria-label={group.label} class="flex flex-col gap-0.5">
        {group.destinations.map(({ href, label, icon: Icon }) => {
          const active = href === activeHref;
          return (
            <li>
              <a
                href={href}
                aria-label={label}
                title={label}
                aria-current={active ? 'page' : undefined}
                class={`relative flex h-9 items-center gap-3 rounded-md px-3 text-[13px] capitalize transition-colors duration-150 ${
                  active
                    ? 'bg-white/[0.05] text-foreground before:absolute before:left-0 before:inset-y-2 before:w-[2px] before:rounded-full before:bg-[#a855f7]'
                    : 'text-muted-foreground hover:bg-white/[0.03] hover:text-foreground'
                }`}
              >
                <Icon size={15} className={`shrink-0 ${active ? 'text-[#a855f7]' : ''}`} />
                <span class="sidebar-label truncate">{label}</span>
              </a>
            </li>
          );
        })}
      </ul>
    </div>
  ))}
</div>
