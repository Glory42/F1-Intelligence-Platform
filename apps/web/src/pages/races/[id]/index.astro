---
import BaseLayout from '@/layouts/BaseLayout.astro';
import { RaceResultsTable } from '@/features/races/components/RaceResultsTable';
import { QualifyingGrid } from '@/features/races/components/QualifyingGrid';
import LapChart from '@/features/races/components/LapChart.astro';
import RaceHeroInfo from '@/features/races/components/RaceHeroInfo.astro';
import RacePredictionPanel from '@/features/races/components/RacePredictionPanel.astro';
import SessionSwitcher from '@/features/races/components/SessionSwitcher.astro';
import RaceTabs from '@/features/races/components/RaceTabs.astro';
import RaceTabPanel from '@/features/races/components/RaceTabPanel.astro';
import RaceEventPanels from '@/features/races/components/RaceEventPanels.astro';
import CircuitStatsGrid from '@/features/races/components/CircuitStatsGrid.astro';
import { api } from '@/lib/api';
import { formatDate } from '@/lib/utils';
import { gridDrops } from '@/features/races/gridPenalties';
import { NO_RACE_EVENTS, loadRaceEvents, raceEventTabs } from '@/features/races/loadRaceEvents';
import { circuitYearItems, conditionsOf, driverMapOf, fastestLapOf, predictedPodium, winnerOf } from '@/features/races/raceView';
import type { PredictionResponse, CircuitHistoryItem, RaceDetailResponse } from '@/types';
import { GP_ACCENT } from '@/features/predictions/types';

// OpenF1 notes F1 releases far fewer radio clips from 2026 on, so an empty list there is expected.
const RADIO_SPARSE_FROM_YEAR = 2026;

const { id } = Astro.params;

let raceData: RaceDetailResponse | null = null;
let error = null;
try {
  raceData = await api.getRaceById(Number(id));
} catch (e) {
  error = e instanceof Error ? e.message : 'Failed to load race';
}

const race = raceData?.race;
let prediction: PredictionResponse | null = null;
let circuitHistory: CircuitHistoryItem[] = [];
let events = NO_RACE_EVENTS;
if (race) {
  const [predResult, circuitResult, eventsResult] = await Promise.allSettled([
    api.getPredictionByRace(race.id),
    api.getCircuitDetails(race.circuit.circuitKey),
    loadRaceEvents(race.id, 'race'),
  ]);
  if (predResult.status === 'fulfilled') prediction = predResult.value;
  if (circuitResult.status === 'fulfilled') circuitHistory = circuitResult.value.history;
  if (eventsResult.status === 'fulfilled') events = eventsResult.value;
}

const results = raceData?.results ?? [];
const qualifying = raceData?.qualifying ?? [];
const laps = raceData?.laps ?? [];
const isCompleted = race?.status === 'completed';
const isQualiDone = race?.status === 'qualifying_done';
const isSprintish = race?.status === 'sprint_done' || race?.status === 'sprint_qualifying_done';
const raceYear = race ? new Date(race.raceDate).getFullYear() : new Date().getFullYear();

const eventTabs = isCompleted ? raceEventTabs(events, raceYear >= RADIO_SPARSE_FROM_YEAR) : [];
const tabs = [
  ...(isCompleted && results.length > 0 ? [{ id: 'results', label: 'Results' }] : []),
  ...(qualifying.length > 0 ? [{ id: 'qualifying', label: 'Qualifying' }] : []),
  ...(isCompleted && laps.length > 0 ? [{ id: 'laps', label: 'Lap Chart' }] : []),
  ...eventTabs,
  { id: 'circuit', label: 'Circuit' },
];
const defaultTab = tabs[0].id;

const drops = gridDrops(results, qualifying);
const podium = predictedPodium(prediction?.drivers ?? []);
const actualWinner = winnerOf(results);
const predCorrect = prediction && actualWinner ? prediction.predictedWinner.id === actualWinner.driver.id : null;

const statusToneClass = isCompleted
  ? 'border-[rgba(168,85,247,0.3)] text-[rgba(168,85,247,0.7)]'
  : isQualiDone
  ? 'border-yellow-500/30 text-yellow-400/70'
  : isSprintish
  ? 'border-orange-500/30 text-orange-400/70'
  : 'border-white/[0.08] text-muted-foreground';
---

<BaseLayout title={race?.name ?? 'Race'}>
  <div class="space-y-8">

    <div class="flex flex-wrap items-center justify-between gap-3">
      <a href="/races" class="inline-block font-mono text-[9px] tracking-[0.15em] uppercase text-muted-foreground hover:text-foreground transition-colors duration-150">
        ← all races
      </a>
      {race?.hasSprint && <SessionSwitcher raceId={race.id} current="gp" />}
    </div>

    {error ? (
      <div class="border border-destructive/40 bg-destructive/10 p-8 text-center">
        <p class="font-mono text-[10px] text-destructive tracking-widest uppercase">Race not found</p>
      </div>
    ) : raceData && race ? (
      <>
        {/* ── HERO ── */}
        <div class="panel">
          <div class="grid lg:grid-cols-[1fr_320px]">
            <RaceHeroInfo
              kicker={`./round-${race.roundNumber.toString().padStart(2, '0')}`}
              statusIcon={isCompleted ? 'check' : (isQualiDone || isSprintish) ? 'zap' : 'timer'}
              statusLabel={race.status.replace(/_/g, ' ')}
              statusToneClass={statusToneClass}
              raceName={race.name}
              circuit={race.circuit}
              dateStr={formatDate(race.raceDate)}
              lapsLabel={`${race.circuit.lapCount} laps`}
              lengthKm={race.circuit.trackLengthKm}
              weather={race.weather}
              conditions={conditionsOf(race)}
              fastestLap={fastestLapOf(results, laps)}
              accent={GP_ACCENT}
              countdown={!isCompleted ? { id: 'race-countdown', date: race.raceDateUtc || race.raceDate, borderClass: 'border-white/[0.08]', digitClass: 'countdown-d' } : null}
              yearItems={circuitYearItems(circuitHistory, 'race')}
              currentYear={raceYear}
            />

            <RacePredictionPanel
              accent={GP_ACCENT}
              heading="./prediction"
              fullHref={`/prediction/${race.id}`}
              hasPrediction={!!prediction}
              predictedWinnerName={prediction?.predictedWinner.fullName}
              winnerLabel="predicted winner"
              confidence={Math.round(Number(podium[0]?.winProbability ?? 0) * 100)}
              podium={podium}
              showAccuracy={isCompleted}
              predCorrect={predCorrect}
              actualWinnerName={isCompleted && actualWinner && actualWinner.driver.id !== prediction?.predictedWinner.id ? actualWinner.driver.fullName : null}
              actualLabel="actual winner"
              emptyText={isCompleted ? 'No prediction data' : 'Available after qualifying'}
            />
          </div>
        </div>

        {/* ── TABS ── */}
        <div>
          <RaceTabs tabs={tabs} defaultTab={defaultTab} accent={GP_ACCENT} links={isCompleted ? [
            { href: `/races/${race.id}/race-story`, label: 'Race story' },
            { href: `/races/${race.id}/telemetry`, label: 'Telemetry' },
          ] : []} />

          {isCompleted && results.length > 0 && (
            <RaceTabPanel id="results" defaultTab={defaultTab}>
              <div class="border border-white/[0.06] overflow-hidden">
                <RaceResultsTable results={results} year={raceYear} laps={laps} />
              </div>
              {drops.length > 0 && (
                <ul aria-label="Grid drops" class="mt-3 border border-white/[0.06] divide-y divide-white/[0.06] font-mono text-[11px]">
                  {drops.map((d) => (
                    <li class="px-4 py-2 text-muted-foreground">
                      {d.pitLane ? `${d.code} qualified P${d.qualified}, started from the pit lane` : `${d.code} qualified P${d.qualified}, started P${d.started} (−${d.places})`}
                    </li>
                  ))}
                </ul>
              )}
            </RaceTabPanel>
          )}

          {qualifying.length > 0 && (
            <RaceTabPanel id="qualifying" defaultTab={defaultTab}>
              <div class="border border-white/[0.06] overflow-hidden">
                <QualifyingGrid qualifying={qualifying} year={raceYear} />
              </div>
            </RaceTabPanel>
          )}

          {isCompleted && laps.length > 0 && (
            <RaceTabPanel id="laps" defaultTab={defaultTab}>
              <div class="border border-white/[0.06] overflow-hidden">
                <LapChart laps={laps} />
              </div>
            </RaceTabPanel>
          )}

          <RaceEventPanels events={events} tabs={eventTabs} defaultTab={defaultTab} driverMap={driverMapOf(results)} year={raceYear} />

          <RaceTabPanel id="circuit" defaultTab={defaultTab}>
            <CircuitStatsGrid circuit={race.circuit} session="race" />
          </RaceTabPanel>
        </div>
      </>
    ) : null}
  </div>
</BaseLayout>

<script>
  import { initRaceCountdown } from '@/features/races/raceTabs';

  document.addEventListener('astro:page-load', () => {
    initRaceCountdown('race-countdown', 'raceDate', 'countdown-d');
  });
</script>
