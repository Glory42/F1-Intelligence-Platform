---
import BaseLayout from '@/layouts/BaseLayout.astro';
import { RaceResultsTable } from '@/features/races/components/RaceResultsTable';
import { QualifyingGrid } from '@/features/races/components/QualifyingGrid';
import LapChart from '@/features/races/components/LapChart.astro';
import RaceControlTimeline from '@/features/races/components/RaceControlTimeline.astro';
import OvertakesList from '@/features/races/components/OvertakesList.astro';
import TeamRadioList from '@/features/races/components/TeamRadioList.astro';
import RaceHeroInfo from '@/features/races/components/RaceHeroInfo.astro';
import RacePredictionPanel from '@/features/races/components/RacePredictionPanel.astro';
import SessionSwitcher from '@/features/races/components/SessionSwitcher.astro';
import RaceTabs from '@/features/races/components/RaceTabs.astro';
import RaceTabPanel from '@/features/races/components/RaceTabPanel.astro';
import StintChart from '@/features/races/components/StintChart.astro';
import { PitStopTable } from '@/features/races/components/PitStopTable';
import { api } from '@/lib/api';
import { formatDate, formatMs, unwrapSettled } from '@/lib/utils';
import type { SprintDetailResponse, RaceResult, QualifyingResult, CircuitHistoryItem, RaceControlMessage, RaceOvertake, TeamRadioClip, Driver, StrategyResponse } from '@/types';
import { RotateCcw, Gauge, Zap, Flag, CornerDownRight, Wind } from 'lucide-react';
import type { LucideIcon } from 'lucide-react';
import { SPRINT_ACCENT } from '@/features/predictions/types';

const { id } = Astro.params;

let sprintData: SprintDetailResponse | null = null;
let circuitHistory: CircuitHistoryItem[] = [];
let error: string | null = null;

let raceControlMessages: RaceControlMessage[] = [];
let overtakes: RaceOvertake[] = [];
let teamRadio: TeamRadioClip[] = [];
let strategy: StrategyResponse | null = null;

const [sprintResult, raceControlResult, overtakesResult, teamRadioResult, strategyResult] = await Promise.allSettled([
  api.getSprintDetail(Number(id)),
  api.getRaceControlMessages(Number(id), 'sprint'),
  api.getOvertakes(Number(id), 'sprint'),
  api.getTeamRadio(Number(id), 'sprint'),
  api.getStrategy(Number(id), 'sprint'),
]);
if (sprintResult.status === 'fulfilled') {
  sprintData = sprintResult.value;
} else {
  error = sprintResult.reason instanceof Error ? sprintResult.reason.message : 'Failed to load sprint data';
}
raceControlMessages = unwrapSettled(raceControlResult, []);
overtakes = unwrapSettled(overtakesResult, []);
teamRadio = unwrapSettled(teamRadioResult, []);
strategy = unwrapSettled(strategyResult, null);
const hasStrategy = (strategy?.drivers ?? []).some((d) => d.stints.length > 0);

const race = sprintData?.race ?? null;
const prediction = sprintData?.prediction ?? null;
const rawResults = sprintData?.results ?? [];
const results = rawResults.filter((r) => r.status !== 'grid_set');
const laps = sprintData?.laps ?? [];

if (race) {
  try {
    circuitHistory = (await api.getCircuitDetails(race.circuit.circuitKey)).history;
  } catch {
    circuitHistory = [];
  }
}

const isSprintDone = race != null && ['sprint_done', 'qualifying_done', 'completed'].includes(race.status);
const isUpcoming = race != null && !isSprintDone;

const hasResults = results.length > 0;
const hasLaps = laps.length > 0;
const hasPrediction = prediction != null;
const driverMap = new Map<number, Driver>(results.map((r) => [r.driverId, r.driver]));

const sprintWinner = hasResults ? results.find((r) => r.finishPosition === 1) : null;
const flResult = hasResults ? results.find((r) => r.fastestLap) : null;
const flLapMs = flResult ? (laps.find((l) => l.driverId === flResult.driver.id)?.fastestLapMs ?? null) : null;

const predCorrect = prediction && sprintWinner
  ? prediction.predictedWinner.id === sprintWinner.driver.id
  : null;

const podium = (prediction?.drivers ?? [])
  .sort((a, b) => (a.predictedPosition ?? 99) - (b.predictedPosition ?? 99))
  .slice(0, 5);

// SQ grid — map SprintResult → QualifyingResult shape so QualifyingGrid can be reused
const sqGrid: QualifyingResult[] = [...rawResults]
  .sort((a, b) => a.gridPosition - b.gridPosition)
  .map((r) => ({
    id: r.id,
    driverId: r.driverId,
    gridPosition: r.gridPosition,
    q1TimeMs: r.sq1TimeMs ?? null,
    q2TimeMs: r.sq2TimeMs ?? null,
    q3TimeMs: r.sq3TimeMs ?? null,
    sector1Ms: r.sqSector1Ms ?? null,
    sector2Ms: r.sqSector2Ms ?? null,
    sector3Ms: r.sqSector3Ms ?? null,
    speedSt: r.sqSpeedSt ?? null,
    driver: r.driver,
  }));
const hasGrid = sqGrid.length > 0;

type Tab = { id: string; label: string };
const tabs: Tab[] = [];
if (isSprintDone && hasResults) tabs.push({ id: 'results', label: 'Results' });
if (hasGrid) tabs.push({ id: 'qualifying', label: 'Sprint Quali' });
if (isSprintDone && hasLaps) tabs.push({ id: 'laps', label: 'Lap Chart' });
if (isSprintDone && hasStrategy) tabs.push({ id: 'strategy', label: 'Strategy' });
if (isSprintDone && raceControlMessages.length > 0) tabs.push({ id: 'incidents', label: 'Incidents' });
if (isSprintDone && overtakes.length > 0) tabs.push({ id: 'overtakes', label: 'Overtakes' });
if (isSprintDone && teamRadio.length > 0) tabs.push({ id: 'team-radio', label: 'Team Radio' });
tabs.push({ id: 'circuit', label: 'Circuit' });

const defaultTab = tabs[0]?.id ?? 'circuit';
const raceYear = race ? new Date(race.raceDate).getFullYear() : new Date().getFullYear();

const circuitYearItems = circuitHistory
  .filter((h) => h.hasSprint)
  .sort((a, b) => b.year - a.year)
  .map((h) => ({ year: h.year, href: `/races/${h.raceId}/sprint` }));

const sprintDistKm = race ? (17 * Number(race.circuit.trackLengthKm)).toFixed(1) : null;

const conditions: { label: string; val: string | number }[] = [];
if (race) {
  if (race.sprintSafetyCarLaps != null) conditions.push({ label: 'SC Laps', val: race.sprintSafetyCarLaps });
  if (race.sprintVscLaps != null) conditions.push({ label: 'VSC', val: race.sprintVscLaps });
  if (race.sprintAirTempAvg) conditions.push({ label: 'Air', val: `${Math.round(Number(race.sprintAirTempAvg))}°C` });
  if (race.sprintTrackTempAvg) conditions.push({ label: 'Track', val: `${Math.round(Number(race.sprintTrackTempAvg))}°C` });
  if (race.sprintHumidityAvg) conditions.push({ label: 'Humidity', val: `${Math.round(Number(race.sprintHumidityAvg))}%` });
}

const sprintStats: Array<{ Icon: LucideIcon; label: string; val: string | number }> = race ? [
  { Icon: RotateCcw, label: 'Sprint Laps', val: '~17' },
  { Icon: Gauge, label: 'Length', val: `${race.circuit.trackLengthKm} km` },
  { Icon: Flag, label: 'Sprint Dist', val: `${sprintDistKm} km` },
  { Icon: CornerDownRight, label: 'Corners', val: race.circuit.numberOfCorners ?? '—' },
  { Icon: Wind, label: 'DRS Zones', val: race.circuit.drsZones ?? '—' },
  { Icon: Zap, label: 'Overtake Rate', val: race.circuit.overtakeRate ? `${Math.round(Number(race.circuit.overtakeRate) * 100)}%` : '—' },
] : [];
---

<BaseLayout title={race ? `Sprint · ${race.name}` : 'Sprint Race'}>
  <div class="mt-7 space-y-8">

    <div class="flex flex-wrap items-center justify-between gap-3">
      <a href="/races" class="inline-block font-mono text-[9px] tracking-[0.15em] uppercase text-muted-foreground hover:text-foreground transition-colors duration-150">
        ← all races
      </a>
      {race && <SessionSwitcher raceId={race.id} current="sprint" />}
    </div>

    {error ? (
      <div class="border border-destructive/40 bg-destructive/10 p-8 text-center">
        <p class="font-mono text-[10px] text-destructive tracking-widest uppercase">Sprint data not found</p>
      </div>
    ) : sprintData && race ? (
      <>
        {/* ── HERO ── */}
        <div class="panel">
          <div class="grid lg:grid-cols-[1fr_320px]">
            <RaceHeroInfo
              kicker={`./round-${race.roundNumber.toString().padStart(2, '0')} · sprint`}
              statusIcon={isSprintDone ? 'check' : 'timer'}
              statusLabel={isSprintDone ? 'sprint done' : 'sprint upcoming'}
              statusToneClass={isSprintDone ? 'border-orange-500/30 text-orange-400/70' : 'border-white/[0.08] text-muted-foreground'}
              raceName={race.name}
              circuit={race.circuit}
              dateStr={formatDate(race.sprintDate ?? race.raceDate)}
              lapsLabel="~17 laps"
              lengthKm={race.circuit.trackLengthKm}
              weather={race.weather}
              conditions={conditions}
              fastestLap={flResult ? { code: flResult.driver.code, timeStr: flLapMs ? formatMs(flLapMs) : null } : null}
              accent={SPRINT_ACCENT}
              countdown={isUpcoming ? { id: 'sprint-countdown', date: race.sprintDate ?? race.raceDate, borderClass: 'border-orange-500/20', digitClass: 'sprint-cd' } : null}
              yearItems={circuitYearItems}
              currentYear={raceYear}
              yearVariant="orange"
            />

            <RacePredictionPanel
              accent={SPRINT_ACCENT}
              heading="./sprint prediction"
              fullHref={`/prediction/sprint/${id}`}
              hasPrediction={hasPrediction}
              predictedWinnerName={prediction?.predictedWinner.fullName}
              winnerLabel="predicted sprint winner"
              confidence={Math.round(Number(podium[0]?.winProbability ?? 0) * 100)}
              podium={podium}
              showAccuracy={isSprintDone}
              predCorrect={predCorrect}
              actualWinnerName={isSprintDone && sprintWinner && sprintWinner.driver.id !== prediction?.predictedWinner.id ? sprintWinner.driver.fullName : null}
              actualLabel="actual sprint winner"
              emptyText={isSprintDone ? 'No prediction data' : 'Available after sprint qualifying'}
            />
          </div>
        </div>

        {/* ── TABS ── */}
        {tabs.length > 0 && (
          <div>
            <RaceTabs tabs={tabs} defaultTab={defaultTab} accent={SPRINT_ACCENT} namespace="sprint-" links={isSprintDone && race ? [
              { href: `/races/${race.id}/race-story?session=sprint`, label: 'Race story' },
              { href: `/races/${race.id}/telemetry?session=SQ`, label: 'Telemetry' },
            ] : []} />

            {isSprintDone && hasResults && (
              <RaceTabPanel id="results" defaultTab={defaultTab} namespace="sprint-">
                <div class="border border-white/[0.06] overflow-hidden">
                  <RaceResultsTable results={results as unknown as RaceResult[]} year={raceYear} laps={laps} flColor="#fb923c" />
                </div>
              </RaceTabPanel>
            )}

            {hasGrid && (
              <RaceTabPanel id="qualifying" defaultTab={defaultTab} namespace="sprint-">
                <div class="border border-white/[0.06] overflow-hidden">
                  <QualifyingGrid qualifying={sqGrid} year={raceYear} labelPrefix="SQ" />
                </div>
              </RaceTabPanel>
            )}

            {isSprintDone && hasLaps && (
              <RaceTabPanel id="laps" defaultTab={defaultTab} namespace="sprint-">
                <div class="border border-white/[0.06] overflow-hidden">
                  <LapChart laps={laps} />
                </div>
              </RaceTabPanel>
            )}

            {hasStrategy && strategy && (
              <RaceTabPanel id="strategy" defaultTab={defaultTab} namespace="sprint-">
                <div class="space-y-4">
                  <div class="border border-white/[0.06] p-5">
                    <StintChart drivers={strategy.drivers} approximate={strategy.source === 'derived'} />
                  </div>
                  <div class="border border-white/[0.06] overflow-hidden">
                    <PitStopTable drivers={strategy.drivers} year={raceYear} />
                  </div>
                </div>
              </RaceTabPanel>
            )}

            {raceControlMessages.length > 0 && (
              <RaceTabPanel id="incidents" defaultTab={defaultTab} namespace="sprint-">
                <div class="border border-white/[0.06] overflow-hidden">
                  <RaceControlTimeline messages={raceControlMessages} />
                </div>
              </RaceTabPanel>
            )}

            {overtakes.length > 0 && (
              <RaceTabPanel id="overtakes" defaultTab={defaultTab} namespace="sprint-">
                <div class="border border-white/[0.06] overflow-hidden">
                  <OvertakesList overtakes={overtakes} driverMap={driverMap} />
                </div>
              </RaceTabPanel>
            )}

            {teamRadio.length > 0 && (
              <RaceTabPanel id="team-radio" defaultTab={defaultTab} namespace="sprint-">
                <div class="border border-white/[0.06] overflow-hidden">
                  <TeamRadioList clips={teamRadio} driverMap={driverMap} />
                </div>
              </RaceTabPanel>
            )}

            <RaceTabPanel id="circuit" defaultTab={defaultTab} namespace="sprint-">
              <div class="grid grid-cols-2 sm:grid-cols-3 gap-px bg-white/[0.06]">
                {sprintStats.map(({ Icon, label, val }) => (
                  <div class="bg-black p-5">
                    <div class="flex items-center gap-1 font-mono text-[8px] text-muted-foreground tracking-widest uppercase mb-2">
                      <Icon size={10} />{label}
                    </div>
                    <div class="font-bold text-xl">{val}</div>
                  </div>
                ))}
              </div>
            </RaceTabPanel>
          </div>
        )}

        {!hasPrediction && !hasResults && (
          <div class="border border-white/[0.06] p-10 text-center">
            <Zap size={20} className="text-muted-foreground opacity-20 mx-auto mb-3" />
            <p class="font-mono text-[9px] text-muted-foreground tracking-[0.25em] uppercase">Sprint prediction available after sprint qualifying</p>
            <p class="mt-2 font-mono text-[8px] text-muted-foreground/50">Run ingest_sprint_qualifying → compute_sprint_features → compute_sprint_predictions</p>
          </div>
        )}
      </>
    ) : null}
  </div>
</BaseLayout>

<script>
  import { initRaceCountdown } from '@/features/races/raceTabs';

  document.addEventListener('astro:page-load', () => {
    initRaceCountdown('sprint-countdown', 'raceDate', 'sprint-cd');
  });
</script>
