---
import BaseLayout from '@/layouts/BaseLayout.astro';
import PageHeader from '@/components/page/PageHeader.astro';
import SectionKicker from '@/components/page/SectionKicker.astro';
import Leaderboard from '@/features/history/components/Leaderboard.astro';
import RecordTile from '@/features/history/components/RecordTile.astro';
import RecordChases from '@/features/history/components/RecordChases.astro';
import LineageTimeline from '@/features/history/components/LineageTimeline.astro';
import F1dbCredit from '@/features/history/components/F1dbCredit.astro';
import OnThisDayList from '@/features/history/components/OnThisDayList.astro';
import PageTabs from '@/components/page/PageTabs.astro';
import EmptyState from '@/components/page/EmptyState.astro';
import { RANK_COLORS } from '@/features/history/historyView';
import { HISTORY_TABS, loadHistoryPageData, onThisDayHref } from '@/features/history/loadHistoryPageData';

const {
  tab, title, records, milestones, onThisDay, requestedDay, currentYear, lineages, lineageStart,
} = await loadHistoryPageData(Astro.url);
---

<BaseLayout title={title}>
  <div class="space-y-6">
    <PageHeader kicker="./history" title="History" subtitle="Every world championship season since 1950" />

    <PageTabs tabs={HISTORY_TABS} active={tab} label="History views" />

    {tab === 'records' && (!records ? (
      <EmptyState message="Historical data hasn't been imported yet." />
    ) : (
      <div class="space-y-10">
        <section aria-label="Headline records" class="grid gap-4 sm:grid-cols-2 xl:grid-cols-4">
          <RecordTile label="Most championships" {...records.headline.championships} accent={RANK_COLORS[0]} />
          <RecordTile label="Most race wins" {...records.headline.wins} />
          <RecordTile label="Most pole positions" {...records.headline.poles} />
          <RecordTile label="Most race starts" {...records.headline.starts} />
        </section>

        <p class="-mt-6 flex items-center justify-end gap-1.5 font-mono text-[8px] tracking-[0.15em] uppercase text-muted-foreground">
          <span class="h-1.5 w-1.5 rounded-full bg-emerald-300" aria-hidden="true" /> on the current grid
        </p>

        {records.chases.some((c) => c.chaser) && (
          <section>
            <SectionKicker label="./chasing the record" />
            <RecordChases chases={records.chases} />
          </section>
        )}

        <section>
          <SectionKicker label="./drivers" />
          <div class="grid gap-4 sm:grid-cols-2 xl:grid-cols-4">
            <Leaderboard title="Most race wins" entries={records.drivers.wins} />
            <Leaderboard title="Most championships" entries={records.drivers.championships} />
            <Leaderboard title="Most pole positions" entries={records.drivers.poles} />
            <Leaderboard title="Most podiums" entries={records.drivers.podiums} />
          </div>
        </section>

        <section>
          <SectionKicker label="./longevity & strike rate" />
          <div class="grid gap-4 sm:grid-cols-2 xl:grid-cols-4">
            <Leaderboard title="Most race starts" entries={records.drivers.starts} />
            <Leaderboard title="Best win rate" note={`min ${records.rateMinStarts} starts`} entries={records.rates.winRate} />
            <Leaderboard title="Best pole rate" note={`min ${records.rateMinStarts} starts`} entries={records.rates.poleRate} />
            <Leaderboard title="Best podium rate" note={`min ${records.rateMinStarts} starts`} entries={records.rates.podiumRate} />
          </div>
        </section>

        <section>
          <SectionKicker label="./constructors" />
          <div class="grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
            <Leaderboard title="Most constructor wins" entries={records.constructors.wins} />
            <Leaderboard title="Most constructors' titles" entries={records.constructors.championships} />
            <Leaderboard title="Most constructor poles" entries={records.constructors.poles} />
          </div>
        </section>
      </div>
    ))}

    {tab === 'milestones' && (!milestones ? (
      <EmptyState message="Historical data hasn't been imported yet." />
    ) : (
      <div class="space-y-10">
        <section aria-label="Headline milestones" class="grid gap-4 sm:grid-cols-3">
          {([
            ['Youngest winner', milestones.headline.youngestWinner],
            ['Youngest polesitter', milestones.headline.youngestPole],
            ['Oldest first-time winner', milestones.headline.oldestFirstWin],
          ] as const).map(([label, tile]) => tile && <RecordTile label={label} {...tile} />)}
        </section>

        <section>
          <SectionKicker label="./firsts" />
          <div class="grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
            <Leaderboard title="Youngest winners" bars={false} entries={milestones.rows.youngestWinner} />
            <Leaderboard title="Youngest polesitters" bars={false} entries={milestones.rows.youngestPole} />
            <Leaderboard title="Youngest podium finishers" bars={false} entries={milestones.rows.youngestPodium} />
            <Leaderboard title="Youngest starters" bars={false} entries={milestones.rows.youngestStarter} />
            <Leaderboard title="Oldest first-time winners" bars={false} entries={milestones.rows.oldestFirstWin} />
            <Leaderboard title="Longest wait for a first win" note="debut to first win" bars={false} entries={milestones.rows.longestWaitForWin} />
          </div>
        </section>
      </div>
    ))}

    {tab === 'on-this-day' && (
      <OnThisDayList result={onThisDay} requested={requestedDay} currentYear={currentYear} hrefFor={onThisDayHref} />
    )}

    {tab === 'lineage' && (lineages.length === 0 ? (
      <EmptyState message="Historical data hasn't been imported yet." />
    ) : (
      <section class="space-y-3">
        <p class="text-[13px] text-muted-foreground">
          Teams that raced under more than one name, traced from their first entry to today.
        </p>
        <LineageTimeline lineages={lineages} startYear={lineageStart} endYear={currentYear} />
      </section>
    ))}

    <F1dbCredit />
  </div>
</BaseLayout>
