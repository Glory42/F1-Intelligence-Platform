---
import BaseLayout from '@/layouts/BaseLayout.astro';
import { api } from '@/lib/api';
import { unwrapSettled } from '@/lib/utils';
import type { Race } from '@/types';
import PageHeader from '@/components/shared/PageHeader.astro';
import NextRaceBlock from '@/features/hub/components/NextRaceBlock.astro';
import LastRaceBlock from '@/features/hub/components/LastRaceBlock.astro';
import ChampionshipBlock from '@/features/hub/components/ChampionshipBlock.astro';

const year = new Date().getFullYear();
const today = new Date();

const [racesResult, predictionResult, driversResult, teamsResult] = await Promise.allSettled([
  api.getRaces(year),
  api.getUpcomingPrediction(),
  api.getDriverStandings(year),
  api.getTeamStandings(year),
]);
const races: Race[] = unwrapSettled(racesResult, []);
const prediction = unwrapSettled(predictionResult, null);

const lastRace = races
  .filter((r) => r.status === 'completed')
  .sort((a, b) => b.roundNumber - a.roundNumber)[0] ?? null;
// The upcoming prediction only exists once qualifying is done, so its race is the next one.
const nextRace = prediction?.race ?? races
  .filter((r) => r.status !== 'completed')
  .sort((a, b) => a.roundNumber - b.roundNumber)[0] ?? null;
const recap = lastRace ? await api.getRaceRecap(lastRace.id).catch(() => null) : null;
---

<BaseLayout title="Dashboard">
  <div class="space-y-6">
    <PageHeader kicker="./home" title={`${year} season`} />

    <div class="grid grid-cols-1 gap-6 lg:grid-cols-2">
      <NextRaceBlock race={nextRace} prediction={prediction} today={today} />
      <LastRaceBlock race={lastRace} recap={recap} />
    </div>

    <ChampionshipBlock drivers={unwrapSettled(driversResult, [])} teams={unwrapSettled(teamsResult, [])} />
  </div>
</BaseLayout>
