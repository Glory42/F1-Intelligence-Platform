---
import BaseLayout from '@/layouts/BaseLayout.astro';
import { CircuitsGrid } from '@/features/circuits/components/CircuitsGrid';
import { api } from '@/lib/api';
import type { Circuit, Race } from '@/types';
import PageHeader from '@/components/shared/PageHeader.astro';
import PageTabs from '@/components/shared/PageTabs.astro';
import EmptyState from '@/components/shared/EmptyState.astro';
import { resolveTab } from '@/lib/pageTabs';

const TABS = [
  { id: 'season', label: 'This season' },
  { id: 'all', label: 'All circuits' },
] as const;

const year = new Date().getFullYear();
const tab = resolveTab(Astro.url, TABS);

let circuits: Circuit[] = [];
let seasonRaces: Race[] = [];
let error: string | null = null;
try {
  [circuits, seasonRaces] = await Promise.all([
    api.getCircuits(),
    tab === 'season' ? api.getRaces(year).catch(() => []) : [],
  ]);
} catch (e) {
  error = e instanceof Error ? e.message : 'Failed to load circuits';
}

const seasonCircuitIds = new Set(seasonRaces.map((r) => r.circuit.id));
const shown = tab === 'season' ? circuits.filter((c) => seasonCircuitIds.has(c.id)) : circuits;
---

<BaseLayout title="Circuits">
  <div class="space-y-6">
    <PageHeader
      kicker="./circuits"
      title="Circuits"
      subtitle={tab === 'season' ? `${shown.length} on the ${year} calendar` : `${circuits.length} circuits raced`}
    />

    <PageTabs tabs={TABS} active={tab} label="Circuits views" />

    {error ? (
      <EmptyState tone="error" message="Couldn't load the circuits. Try again in a moment." />
    ) : shown.length === 0 ? (
      <EmptyState message={`No ${year} calendar yet.`} />
    ) : (
      <CircuitsGrid initialCircuits={shown} client:load />
    )}
  </div>
</BaseLayout>
