---
import BaseLayout from '@/layouts/BaseLayout.astro';
import { api } from '@/lib/api';
import { MapPin } from 'lucide-react';
import { getCountryFlag } from '@/lib/f1/countryFlags';
import { getCircuitCoordinates } from '@/features/circuits/circuitCoordinates';
import CircuitOverview from '@/features/circuits/components/CircuitOverview.astro';
import { isRaceWeekCircuit } from '@/features/circuits/circuitView';
import CircuitTelemetryProfile from '@/features/circuits/components/CircuitTelemetryProfile.astro';
import EmptyState from '@/components/page/EmptyState.astro';
import CircuitWinnersTable from '@/features/circuits/components/CircuitWinnersTable.astro';
import CircuitWinningFacts from '@/features/circuits/components/CircuitWinningFacts.astro';
import DominanceCard from '@/features/circuits/components/DominanceCard.astro';
import { getWeatherForecast, type ForecastDay } from '@/features/circuits/weather';
import PageTabs from '@/components/page/PageTabs.astro';
import { resolveTab } from '@/lib/pageTabs';

const TABS = [
  { id: 'overview', label: 'Overview' },
  { id: 'winners', label: 'Winners' },
  { id: 'dominance', label: 'Dominance' },
  { id: 'telemetry', label: 'Telemetry' },
] as const;
const tab = resolveTab(Astro.url, TABS);

const { key } = Astro.params;
if (!key) return Astro.redirect('/races');

const [detailsResult, racesResult, telemetryResult] = await Promise.allSettled([
  api.getCircuitDetails(key),
  tab === 'overview' ? api.getRaces(new Date().getFullYear()) : Promise.resolve([]),
  tab === 'telemetry' ? api.getCircuitTelemetry(key) : Promise.resolve(null),
]);
if (detailsResult.status === 'rejected') return Astro.redirect('/races');

const details = detailsResult.value;
const { circuit, history, fastestLap, dominance, qualifyingImpact } = details;
const telemetry = telemetryResult.status === 'fulfilled' ? telemetryResult.value : null;
const { lat, lng } = getCircuitCoordinates(circuit.circuitKey);
const showForecast = racesResult.status === 'fulfilled' && isRaceWeekCircuit(racesResult.value, circuit.circuitKey);
const forecast: ForecastDay[] | null = showForecast && lat !== 0 && lng !== 0
  ? await getWeatherForecast(lat, lng).catch(() => null)
  : null;
---

<BaseLayout title={`${circuit.name} - Circuit Details`}>
  <div class="space-y-6">
    <div>
      <a href="/circuits" class="font-mono text-[9px] tracking-[0.15em] uppercase text-muted-foreground hover:text-foreground transition-colors duration-150">← all circuits</a>
      <h1 class="mt-4 text-2xl font-bold">
        {circuit.name} <span class="text-xl ml-1.5 align-middle select-none">{getCountryFlag(circuit.country)}</span>
      </h1>
      <div class="flex items-center gap-2 mt-1 font-mono text-[10px] text-muted-foreground tracking-widest uppercase">
        <MapPin size={10} /> {circuit.city}, {circuit.country}
      </div>
    </div>

    <PageTabs tabs={TABS} active={tab} label="Circuit views" />

    {tab === 'overview' ? (
      <CircuitOverview details={details} lat={lat} lng={lng} showForecast={showForecast} forecast={forecast} />
    ) : tab === 'winners' ? (
      <div class="grid grid-cols-1 lg:grid-cols-3 gap-6 items-start">
        <div class="lg:col-span-2">
          <CircuitWinnersTable history={history} />
        </div>
        <CircuitWinningFacts
          history={history}
          poleToWinRate={qualifyingImpact.poleToWinRate}
          avgWinnerGridPos={qualifyingImpact.avgWinnerGridPos}
          fastestLap={fastestLap}
        />
      </div>
    ) : tab === 'dominance' ? (
      <DominanceCard dominance={dominance} />
    ) : (
      telemetry
        ? <CircuitTelemetryProfile telemetry={telemetry} />
        : <EmptyState message="No qualifying telemetry here yet — OpenF1 car data starts in 2023." />
    )}
  </div>
</BaseLayout>
