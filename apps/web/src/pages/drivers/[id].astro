---
import BaseLayout from '@/layouts/BaseLayout.astro';
import { DriverStatsGrid } from '@/features/drivers/components/DriverStatsGrid';
import { RecentResultsTable } from '@/features/drivers/components/RecentResultsTable';
import TeammateBattleCard from '@/features/drivers/components/TeammateBattleCard.astro';
import CareerCard from '@/features/history/components/CareerCard.astro';
import DriverCareerTable from '@/features/drivers/components/DriverCareerTable.astro';
import ModelTrackRecord from '@/features/drivers/components/ModelTrackRecord.astro';
import { Trophy } from 'lucide-react';
import YearSelectLinks from '@/components/page/YearSelectLinks.astro';
import PageTabs from '@/components/page/PageTabs.astro';
import EmptyState from '@/components/page/EmptyState.astro';
import { getTeamColor } from '@/lib/f1/teamColors';
import { DRIVER_TABS, loadDriverPageData } from '@/features/drivers/loadDriverPageData';

const {
  tab, year, yearLinks, error, career, detail: data, headshotUrl, titles, nationalityFlag,
  teammateBattle, driverHistory, predictionRecord,
} = await loadDriverPageData(Astro.url, Number(Astro.params.id));
const driver = data?.driver;
---

<BaseLayout title={driver?.fullName ?? 'Driver'}>
  <div>
    <div class="mb-6 flex items-center gap-4">
      <a href={`/drivers?year=${year}`} class="font-mono text-[9px] tracking-[0.15em] uppercase text-muted-foreground hover:text-foreground transition-colors duration-150">
        ← all drivers
      </a>
      {yearLinks.length > 1 && (
        <div class="ml-auto">
          <YearSelectLinks items={yearLinks} currentYear={year} />
        </div>
      )}
    </div>

    {error ? (
      <div class="border border-destructive/40 bg-destructive/10 p-8 text-center">
        <p class="font-mono text-[10px] text-destructive tracking-widest uppercase">Driver not found</p>
      </div>
    ) : data && driver ? (
      <div class="space-y-8">

        <!-- Header -->
        <div class="flex items-start gap-6">
          {headshotUrl ? (
            <img
              src={headshotUrl}
              alt={driver.fullName}
              class="w-20 h-20 object-cover object-top border border-white/[0.08] shrink-0 bg-white/[0.02]"
              loading="lazy"
            />
          ) : (
            <div class="w-16 h-16 border border-white/[0.08] flex items-center justify-center shrink-0">
              <span class="text-2xl font-black text-[#a855f7]">{driver.driverNumber}</span>
            </div>
          )}
          <div>
            <div class="flex items-center gap-3 mb-1">
              <span class="font-mono text-[8px] tracking-[0.15em] uppercase text-muted-foreground border border-white/[0.06] px-1.5 py-0.5">
                #{driver.driverNumber} · {driver.code}
              </span>
              {driver.nationality && (
                <span class="font-mono text-[9px] text-muted-foreground">· {driver.nationality}</span>
              )}
            </div>
            <div class="flex items-center gap-3">
              <h1 class="text-2xl font-bold">
                {driver.fullName} <span class="text-xl ml-1.5 align-middle select-none">{nationalityFlag}</span>
              </h1>
              {titles > 0 && (
                <div class="flex items-center gap-1" title={`${titles}× World Champion`}>
                  {Array.from({ length: titles }).map((_, i) => (
                    <Trophy key={i} size={16} color="#a855f7" />
                  ))}
                </div>
              )}
            </div>
            <a href={`/teams/${driver.team.id}?year=${year}`} class="inline-flex items-center gap-1.5 font-mono text-[10px] text-muted-foreground hover:text-foreground transition-colors duration-150 tracking-wider">
              <div class="w-2 h-2 rounded-full shrink-0" style={`background: ${getTeamColor(driver.team.teamKey)};`} />
              {driver.team.name} · {year} Season
            </a>
          </div>
        </div>

        <PageTabs tabs={DRIVER_TABS} active={tab} label="Driver views" />

        {tab === 'season' ? (
          <div class="space-y-8">
            <div>
              <div class="flex items-center gap-3 mb-4">
                <span class="flex items-center gap-1.5 font-mono text-[9px] tracking-[0.25em] uppercase" style="color: rgba(168,85,247,0.55)">./stats · {year}</span>
                <div class="h-px flex-1 bg-white/[0.05]" />
              </div>
              <DriverStatsGrid stats={data.seasonStats} />
            </div>
            {data.recentResults.length > 0 && (
              <div>
                <div class="flex items-center gap-3 mb-4">
                  <span class="flex items-center gap-1.5 font-mono text-[9px] tracking-[0.25em] uppercase" style="color: rgba(168,85,247,0.55)">./recent results</span>
                  <div class="h-px flex-1 bg-white/[0.05]" />
                </div>
                <div class="border border-white/[0.06] overflow-hidden">
                  <RecentResultsTable results={data.recentResults} />
                </div>
              </div>
            )}
          </div>
        ) : tab === 'teammate' ? (
          teammateBattle
            ? <TeammateBattleCard battle={teammateBattle} driver={driver} year={year} />
            : <EmptyState message={`No teammate battle for ${driver.code} in ${year}.`} />
        ) : tab === 'career' ? (
          <div class="space-y-8">
            {driverHistory && <CareerCard history={driverHistory} />}
            <DriverCareerTable career={career} year={year} />
          </div>
        ) : (
          predictionRecord
            ? <ModelTrackRecord record={predictionRecord} driverCode={driver.code} year={year} />
            : <EmptyState message={`No predictions for ${year} yet.`} />
        )}

      </div>
    ) : null}
  </div>
</BaseLayout>
