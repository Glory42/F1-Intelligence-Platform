---
import BaseLayout from '@/layouts/BaseLayout.astro';
import { api } from '@/lib/api';
import type { DriverStanding, SeasonSummary, Race, TitleOddsResponse, RacecraftRow } from '@/types';
import PageHeader from '@/components/page/PageHeader.astro';
import PageTabs from '@/components/page/PageTabs.astro';
import EmptyState from '@/components/page/EmptyState.astro';
import YearSelect from '@/components/page/YearSelect.astro';
import DriverStandingsTable from '@/features/standings/components/DriverStandingsTable.astro';
import TitleFight from '@/features/standings/components/TitleFight.astro';
import RacecraftTable from '@/features/standings/components/RacecraftTable.astro';
import { resolveTab, seasonTabHref } from '@/lib/pageTabs';

const TABS = [
  { id: 'standings', label: 'Standings' },
  { id: 'title-fight', label: 'Title fight' },
  { id: 'racecraft', label: 'Racecraft' },
] as const;

const year = Number(Astro.url.searchParams.get('year') ?? new Date().getFullYear());
const tab = resolveTab(Astro.url, TABS);

let seasons: SeasonSummary[] = [];
let standings: DriverStanding[] = [];
let titleOdds: TitleOddsResponse | null = null;
let races: Race[] = [];
let racecraft: RacecraftRow[] = [];
let error: string | null = null;
try {
  [seasons, standings, titleOdds, races, racecraft] = await Promise.all([
    api.getSeasons(),
    tab === 'racecraft' ? [] : api.getDriverStandings(year),
    tab === 'title-fight' ? api.getTitleOdds(year).catch(() => null) : null,
    tab === 'title-fight' ? api.getRaces(year).catch(() => []) : [],
    tab === 'racecraft' ? api.getRacecraft(year).catch(() => []) : [],
  ]);
} catch (e) {
  error = e instanceof Error ? e.message : 'Failed to load standings';
}
---

<BaseLayout title={`${year} Driver Standings`}>
  <div class="space-y-6">
    <PageHeader kicker="./drivers" title={`${year} Drivers`} subtitle={`${year} championship`}>
      <YearSelect slot="aside" years={seasons} currentYear={year} hrefFor={(y: number) => seasonTabHref(Astro.url, TABS, tab, y)} />
    </PageHeader>

    <PageTabs tabs={TABS} active={tab} label="Drivers views" />

    {error ? (
      <EmptyState tone="error" message="Couldn't load the drivers. Try again in a moment." />
    ) : tab === 'standings' ? (
      standings.length > 0
        ? <DriverStandingsTable standings={standings} year={year} />
        : <EmptyState message={`No standings for ${year} yet.`} />
    ) : tab === 'title-fight' ? (
      titleOdds && standings.length > 0
        ? <TitleFight odds={titleOdds} standings={standings} races={races} year={year} />
        : <EmptyState message={`No title odds for ${year} yet. They start after the first race.`} />
    ) : (
      racecraft.length > 0
        ? <RacecraftTable rows={racecraft} year={year} />
        : <EmptyState message={`No overtake data for ${year} yet.`} />
    )}
  </div>
</BaseLayout>
