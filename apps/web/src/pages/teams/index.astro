---
import BaseLayout from '@/layouts/BaseLayout.astro';
import { api } from '@/lib/api';
import type { TeamStanding, SeasonSummary, PitCrewRanking, TitleOddsResponse } from '@/types';
import PageHeader from '@/components/page/PageHeader.astro';
import PageTabs from '@/components/page/PageTabs.astro';
import EmptyState from '@/components/page/EmptyState.astro';
import YearSelect from '@/components/page/YearSelect.astro';
import TeamStandingsTable from '@/features/standings/components/TeamStandingsTable.astro';
import ConstructorTitleOdds from '@/features/standings/components/ConstructorTitleOdds.astro';
import PitCrewRankingTable from '@/features/teams/components/PitCrewRankingTable.astro';
import { resolveTab, TAB_PARAM } from '@/lib/pageTabs';

const TABS = [
  { id: 'standings', label: 'Standings' },
  { id: 'title-odds', label: 'Title odds' },
  { id: 'pit-crews', label: 'Pit crews' },
] as const;

const year = Number(Astro.url.searchParams.get('year') ?? new Date().getFullYear());
const tab = resolveTab(Astro.url, TABS);

let seasons: SeasonSummary[] = [];
let standings: TeamStanding[] = [];
let titleOdds: TitleOddsResponse | null = null;
let pitCrewRankings: PitCrewRanking[] = [];
let error: string | null = null;
try {
  [seasons, standings, titleOdds, pitCrewRankings] = await Promise.all([
    api.getSeasons(),
    tab === 'standings' ? api.getTeamStandings(year) : [],
    tab === 'title-odds' ? api.getTitleOdds(year).catch(() => null) : null,
    tab === 'pit-crews' ? api.getPitCrewRankings(year).catch(() => []) : [],
  ]);
} catch (e) {
  error = e instanceof Error ? e.message : 'Failed to load standings';
}
---

<BaseLayout title={`${year} Constructor Standings`}>
  <div class="space-y-6">
    <PageHeader kicker="./teams" title={`${year} Teams`} subtitle={`${year} constructors' championship`}>
      <YearSelect slot="aside" years={seasons} currentYear={year} basePath="/teams" extraParams={tab === TABS[0].id ? '' : `&${TAB_PARAM}=${tab}`} />
    </PageHeader>

    <PageTabs tabs={TABS} active={tab} label="Teams views" />

    {error ? (
      <EmptyState tone="error" message="Couldn't load the teams. Try again in a moment." />
    ) : tab === 'standings' ? (
      standings.length > 0
        ? <TeamStandingsTable standings={standings} year={year} />
        : <EmptyState message={`No standings for ${year} yet.`} />
    ) : tab === 'title-odds' ? (
      titleOdds && titleOdds.teams.length > 0
        ? <ConstructorTitleOdds odds={titleOdds} year={year} />
        : <EmptyState message={`No title odds for ${year} yet. They start after the first race.`} />
    ) : (
      pitCrewRankings.length > 0
        ? <PitCrewRankingTable rankings={pitCrewRankings} year={year} />
        : <EmptyState message={`No pit stop data for ${year} yet.`} />
    )}
  </div>
</BaseLayout>
