---
import BaseLayout from '@/layouts/BaseLayout.astro';
import { api } from '@/lib/api';
import type { PredictionHistoryItem, IntelStandingRow, SeasonSummary, SprintPredictionResponse, PredictionResponse, ModelInfo, SeasonAccuracy } from '@/types';
import PageHeader from '@/components/page/PageHeader.astro';
import PageTabs from '@/components/page/PageTabs.astro';
import EmptyState from '@/components/page/EmptyState.astro';
import YearSelect from '@/components/page/YearSelect.astro';
import { GP_ACCENT, SPRINT_ACCENT } from '@/features/predictions/types';
import UpcomingPredictionPanel from '@/features/predictions/components/UpcomingPredictionPanel.astro';
import ModelRatingsTable from '@/features/predictions/components/ModelRatingsTable.astro';
import Scorecard from '@/features/predictions/components/Scorecard.astro';
import { resolveTab, seasonTabHref } from '@/lib/pageTabs';
import { unwrapSettled } from '@/lib/utils';

const TABS = [
  { id: 'upcoming', label: 'Upcoming' },
  { id: 'scorecard', label: 'Scorecard' },
] as const;

const year = Number(Astro.url.searchParams.get('year') ?? new Date().getFullYear());
const tab = resolveTab(Astro.url, TABS);

let upcoming: PredictionResponse | null = null;
let upcomingSprint: SprintPredictionResponse | null = null;
let standings: IntelStandingRow[] = [];
let modelInfo: ModelInfo | null = null;
let history: PredictionHistoryItem[] = [];
let seasons: SeasonSummary[] = [];
let seasonAccuracy: SeasonAccuracy[] = [];

if (tab === 'upcoming') {
  const [upcomingResult, standingsResult, modelInfoResult] = await Promise.allSettled([
    api.getUpcomingPrediction(),
    api.getIntelStandings(year),
    api.getModelInfo(),
  ]);
  upcoming = unwrapSettled(upcomingResult, null);
  standings = unwrapSettled(standingsResult, []);
  modelInfo = unwrapSettled(modelInfoResult, null);

  if (upcoming?.race.hasSprint) {
    try { upcomingSprint = await api.getSprintByRaceId(upcoming.race.id); } catch {}
  }
  if (!upcomingSprint) {
    try { upcomingSprint = await api.getSprintUpcoming(); } catch {}
  }
} else {
  const [historyResult, seasonsResult, accuracyResult] = await Promise.allSettled([
    api.getPredictionHistory(year),
    api.getSeasons(),
    api.getPredictionAccuracy(),
  ]);
  history = unwrapSettled(historyResult, []);
  seasons = unwrapSettled(seasonsResult, []);
  seasonAccuracy = unwrapSettled(accuracyResult, []);
}

const gpVersion = upcoming?.modelVersion ?? modelInfo?.gpVersion ?? 'weighted-v3';
---

<BaseLayout title={tab === 'scorecard' ? `${year} Prediction Scorecard` : 'Predictions'}>
  <div class="space-y-6">
    <PageHeader
      kicker="./predictions"
      title={tab === 'scorecard' ? `${year} Scorecard` : 'Predictions'}
      subtitle={tab === 'scorecard' ? 'how the model did, race by race' : `model ${gpVersion}`}
    >
      {tab === 'scorecard' && (
        <YearSelect slot="aside" years={seasons} currentYear={year} hrefFor={(y: number) => seasonTabHref(Astro.url, TABS, tab, y)} />
      )}
    </PageHeader>

    <PageTabs tabs={TABS} active={tab} label="Predictions views" />

    {tab === 'upcoming' ? (
      <div class="space-y-10">
        {upcoming || upcomingSprint ? (
          <div class={`grid gap-4 ${upcoming && upcomingSprint ? 'grid-cols-1 lg:grid-cols-2' : 'grid-cols-1'}`}>
            {upcomingSprint && (
              <UpcomingPredictionPanel
                winnerName={upcomingSprint.predictedWinner.fullName}
                teamName={upcomingSprint.predictedWinner.team.name}
                drivers={upcomingSprint.drivers}
                modelVersion={upcomingSprint.modelVersion}
                accent={SPRINT_ACCENT}
                kicker={`./sprint · ${upcomingSprint.race.name}`}
                showZap
                detailHref={`/races/${upcomingSprint.race.id}/sprint`}
                detailLabel="detail →"
                winnerLabel="predicted sprint winner"
                confidenceLabel="sprint confidence"
                topBorder
              />
            )}
            {upcoming && (
              <UpcomingPredictionPanel
                winnerName={upcoming.predictedWinner.fullName}
                teamName={upcoming.predictedWinner.team.name}
                drivers={upcoming.drivers}
                modelVersion={upcoming.modelVersion}
                accent={GP_ACCENT}
                kicker={`${upcoming.race.hasSprint ? '⬟ grand prix · ' : './next race · '}${upcoming.race.name}`}
                detailHref={`/prediction/${upcoming.race.id}`}
                detailLabel="full prediction →"
                winnerLabel="predicted winner"
                confidenceLabel="model confidence"
              />
            )}
          </div>
        ) : (
          <EmptyState message="The next prediction appears once qualifying is done." />
        )}
        {standings.length > 0 && <ModelRatingsTable standings={standings} year={year} />}
      </div>
    ) : history.length > 0 ? (
      <Scorecard history={history} seasonAccuracy={seasonAccuracy} year={year} />
    ) : (
      <EmptyState message={`No predictions for ${year} yet.`} />
    )}
  </div>
</BaseLayout>
