---
import BaseLayout from '@/layouts/BaseLayout.astro';
import { api } from '@/lib/api';
import { TeamCompareTool } from '@/features/compare/components/TeamCompareTool';
import PageHeader from '@/components/shared/PageHeader.astro';
import PageTabs from '@/components/shared/PageTabs.astro';
import { COMPARE_TABS } from '@/features/compare/compareTabs';
import type { Team, SeasonSummary } from '@/types';

const year = Number(Astro.url.searchParams.get('year') ?? new Date().getFullYear());

let seasons: SeasonSummary[] = [];
let initialTeams: Team[] = [];
let allTeams: Team[] = [];
let error: string | null = null;
try {
  const [seasonsData, teamsData, searchData] = await Promise.all([
    api.getSeasons(),
    api.getTeams(year),
    api.getGlobalSearch()
  ]);
  seasons = seasonsData;
  initialTeams = teamsData;
  allTeams = searchData.teams;
} catch (e) {
  error = e instanceof Error ? e.message : 'Failed to initialize comparison';
}
---

<BaseLayout title="Team Head-to-Head Comparison">
  <div class="space-y-6">
    
    <PageHeader kicker="./compare" title="Team comparison" subtitle="head-to-head across seasons" />

    <PageTabs tabs={COMPARE_TABS} active="teams" label="Compare views" />

    {error ? (
      <div class="border border-destructive/40 bg-destructive/10 p-8 text-center">
        <p class="font-mono text-[10px] text-destructive tracking-widest uppercase">Failed to initialize compare page</p>
        <p class="mt-2 font-mono text-[9px] text-muted-foreground">{error}</p>
      </div>
    ) : (
      <div><TeamCompareTool allSeasons={seasons} initialTeams={initialTeams} allTeams={allTeams} client:load /></div>
    )}

  </div>
</BaseLayout>
