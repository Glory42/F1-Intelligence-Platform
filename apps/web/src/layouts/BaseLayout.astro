---
import { SITE_NAME } from '@/lib/site';
import Sidebar from '@/components/layout/Sidebar.astro';
import MobileNav from '@/components/layout/MobileNav.astro';
import Footer from '@/components/layout/Footer.astro';
import { GlobalSearch } from '@/features/search/components/GlobalSearch';
import { SIDEBAR_COOKIE, isSidebarCollapsed } from '@/lib/sidebarState';
import { ClientRouter, fade } from 'astro:transitions';

interface Props {
  title: string;
  description?: string;
  image?: string;
}
const {
  title,
  description = 'F1 race prediction and analytics platform',
  image = '/preview/Preview-landingPage.png',
} = Astro.props;
const fullTitle = `${title} | ${SITE_NAME}`;
const canonicalURL = new URL(Astro.url.pathname, Astro.site);
const ogImageURL = new URL(image, Astro.site);
const sidebarCollapsed = isSidebarCollapsed(Astro.cookies.get(SIDEBAR_COOKIE)?.value);
---

<!doctype html>
<html lang="en" class="dark scroll-smooth" data-sidebar={sidebarCollapsed ? 'collapsed' : 'expanded'}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <title>{fullTitle}</title>
    <link rel="canonical" href={canonicalURL} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={SITE_NAME} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={ogImageURL} />
    <meta property="og:url" content={canonicalURL} />

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={fullTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImageURL} />

    <ClientRouter />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Sora:wght@400;500;600;700;800&family=JetBrains+Mono:wght@400;500;700&display=swap" rel="stylesheet" />
  </head>
  <body class="min-h-screen bg-background text-foreground antialiased font-sans">
    <Sidebar collapsed={sidebarCollapsed} />
    <MobileNav />

    <div class="flex min-h-screen flex-col md:pl-[var(--sidebar-w)] transition-[padding] duration-200 ease-spring">
      <main
        class="flex-1 mx-auto w-full max-w-[1400px] px-[max(24px,4vw)] pt-[72px] md:pt-10 pb-24 sm:pb-16"
        transition:animate={fade({ duration: '0.2s' })}
      >
        <slot />
      </main>

      <Footer transition:persist />
    </div>

    <GlobalSearch client:idle transition:persist />
  </body>
</html>

<style is:global>
  @import '../styles/globals.css';
</style>
