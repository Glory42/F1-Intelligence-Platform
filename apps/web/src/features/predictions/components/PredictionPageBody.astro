---
import PredictionHeader from './PredictionHeader.astro';
import PredictionOutcomeBanner from './PredictionOutcomeBanner.astro';
import ContributionBar from './ContributionBar.astro';
import PredictionDriverTable from './PredictionDriverTable.astro';
import DriverRadarCompare from './DriverRadarCompare.astro';
import ModelWeightsGrid from './ModelWeightsGrid.astro';
import WhatIfLab from './WhatIfLab.astro';
import FridayPaceTable from './FridayPaceTable.astro';
import type { PredictionPageData } from '../buildPredictionPageData';
import type { PredictionCopy } from '../predictionCopy';

interface Props {
  data: PredictionPageData;
  copy: PredictionCopy;
}

const { data, copy } = Astro.props;
const {
  race, prediction, results, predictionFailed, raceYear, actualWinner, correct,
  winner, breakdown, radarFeatures, weights, featureMeta, accent, fridayPace,
} = data;
const kicker = race ? copy.kicker(race.roundNumber) : '';
---

<div class="mt-7 space-y-8">

  <div class="mb-6 flex items-center gap-4">
    <a href="/prediction" class="font-mono text-[9px] tracking-[0.15em] uppercase text-muted-foreground hover:text-foreground transition-colors duration-150">
      ← prediction hub
    </a>
  </div>

  {predictionFailed && !prediction ? (
    <div class="border border-white/[0.06] p-10 text-center">
      <p class="font-mono text-[9px] text-muted-foreground tracking-[0.25em] uppercase">{copy.notFoundMessage}</p>
      <p class="mt-2 font-mono text-[8px] text-muted-foreground/50">{copy.fetchErrorMessage}</p>
    </div>
  ) : prediction && race ? (
    <>
      <PredictionHeader
        title={race.name}
        kicker={kicker}
        city={race.circuit.city}
        country={race.circuit.country}
        date={data.date ?? race.raceDate}
        modelVersion={prediction.modelVersion}
        computedAt={prediction.computedAt}
        p1={Number(prediction.drivers[0]?.winProbability)}
        p2={prediction.drivers[1] ? Number(prediction.drivers[1].winProbability) : null}
        accent={accent}
      />

      {correct !== null && actualWinner && (
        <PredictionOutcomeBanner
          predictedName={prediction.predictedWinner.fullName}
          actualName={actualWinner.driver.fullName}
          actualLabel={copy.actualLabel}
          correct={correct}
        />
      )}

      {winner && breakdown.some((b) => b.share > 0) && (
        <ContributionBar driverCode={winner.driver.code} breakdown={breakdown} featureMeta={featureMeta} accent={accent} />
      )}

      {fridayPace.length > 0 && <FridayPaceTable rows={fridayPace} accent={accent} year={raceYear} />}

      <div class="grid grid-cols-1 xl:grid-cols-[1fr_400px] gap-8">
        <PredictionDriverTable
          drivers={prediction.drivers}
          results={results}
          predictedWinnerId={prediction.predictedWinner.id}
          actualWinnerId={actualWinner?.driver.id}
          raceYear={raceYear}
          accent={accent}
          gridColLabel={copy.gridColLabel}
          actualWinnerLabel={copy.actualWinnerLabel}
        />

        <div class="space-y-6">
          <DriverRadarCompare drivers={prediction.drivers} features={radarFeatures} accent={accent} />
          <ModelWeightsGrid heading={copy.weightsHeading} featureMeta={featureMeta} accent={accent} note={copy.weightsNote} class="hidden xl:block" />
        </div>
      </div>

      <WhatIfLab
        drivers={prediction.drivers}
        featureMeta={featureMeta}
        weights={weights}
        accent={accent}
        sliderMax={copy.sliderMax}
        blurb={copy.whatIfBlurb}
      />

      <ModelWeightsGrid
        heading={copy.weightsHeading}
        featureMeta={featureMeta}
        accent={accent}
        gridClass="grid-cols-2 sm:grid-cols-4"
        class="xl:hidden"
      />
    </>
  ) : null}
</div>
