---
import { calibrationBuckets, brierScore } from '@/lib/f1/predictionMath';

interface Props {
  items: { winProbability: string; correct: boolean | null }[];
  bucketSize?: number;
}

const { items, bucketSize = 0.2 } = Astro.props;

const buckets = calibrationBuckets(items, bucketSize);
const completed = items.filter((i) => i.correct !== null).length;
const brier = brierScore(items);

const W = 460;
const H = 300;
const PAD = { top: 16, right: 16, bottom: 36, left: 40 };
const plotW = W - PAD.left - PAD.right;
const plotH = H - PAD.top - PAD.bottom;

const x = (p: number) => PAD.left + p * plotW;
const y = (r: number) => PAD.top + (1 - r) * plotH;

const gridTicks = [0, 0.25, 0.5, 0.75, 1];
const dots = buckets.map((b) => ({
  cx: x(b.meanPredicted),
  cy: y(b.actualRate),
  r: Math.min(11, 3 + Math.sqrt(b.count) * 2.4),
  label: `${Math.round(b.meanPredicted * 100)}% predicted → ${Math.round(b.actualRate * 100)}% actual (${b.count} race${b.count === 1 ? '' : 's'})`,
}));
const trend = dots.map((d) => `${d.cx},${d.cy}`).join(' ');
---

{buckets.length === 0 ? (
  <p class="font-mono text-[9px] text-muted-foreground px-4 py-6">Not enough completed races to plot calibration.</p>
) : (
  <div class="w-full">
    <div>
      <svg viewBox={`0 0 ${W} ${H}`} style={`width:100%;height:auto;max-width:${W}px;margin:0 auto;display:block`} aria-label="Model calibration: predicted vs actual win rate">
        {gridTicks.map((t) => (
          <g>
            <line x1={x(t)} y1={y(0)} x2={x(t)} y2={y(1)} stroke="rgba(255,255,255,0.05)" stroke-width="1" />
            <line x1={x(0)} y1={y(t)} x2={x(1)} y2={y(t)} stroke="rgba(255,255,255,0.05)" stroke-width="1" />
          </g>
        ))}

        <line x1={x(0)} y1={y(0)} x2={x(1)} y2={y(1)} stroke="rgba(255,255,255,0.25)" stroke-width="1" stroke-dasharray="4 4" />

        {dots.length > 1 && (
          <polyline points={trend} fill="none" stroke="rgba(168,85,247,0.4)" stroke-width="1.5" />
        )}
        {dots.map((d) => (
          <circle cx={d.cx} cy={d.cy} r={d.r} fill="rgba(168,85,247,0.25)" stroke="#a855f7" stroke-width="1.5">
            <title>{d.label}</title>
          </circle>
        ))}

        {[0, 0.5, 1].map((t) => (
          <text x={x(t)} y={H - 20} text-anchor="middle" font-family="monospace" font-size="8" fill="rgba(255,255,255,0.4)">{Math.round(t * 100)}</text>
        ))}
        {[0, 0.5, 1].map((t) => (
          <text x={PAD.left - 6} y={y(t) + 3} text-anchor="end" font-family="monospace" font-size="8" fill="rgba(255,255,255,0.4)">{Math.round(t * 100)}</text>
        ))}
        <text x={PAD.left + plotW / 2} y={H - 6} text-anchor="middle" font-family="monospace" font-size="8" fill="rgba(255,255,255,0.3)" letter-spacing="0.1em">PREDICTED WIN %</text>
        <text x={12} y={PAD.top + plotH / 2} text-anchor="middle" font-family="monospace" font-size="8" fill="rgba(255,255,255,0.3)" letter-spacing="0.1em" transform={`rotate(-90, 12, ${PAD.top + plotH / 2})`}>ACTUAL WIN %</text>
      </svg>
      <p class="font-mono text-[8px] text-muted-foreground mt-2 text-center">
        {completed} completed {completed === 1 ? 'race' : 'races'}
        {brier !== null && <> · Brier {brier.toFixed(3)}</>}
        · dot size ∝ races · dashed line = perfect calibration
      </p>
    </div>
  </div>
)}
