---
import { confidenceTier } from '@/lib/f1/predictionMath';

interface Props {
  p1: number;
  p2?: number | null;
  class?: string;
}

const { p1, p2, class: className = '' } = Astro.props;
const tier = confidenceTier(p1, p2 ?? undefined);

const META = {
  lock: { label: 'LOCK', cls: 'border-green-500/40 text-green-400' },
  likely: { label: 'LIKELY', cls: 'border-[rgba(168,85,247,0.45)] text-[#a855f7]' },
  tossup: { label: 'TOSS-UP', cls: 'border-amber-500/40 text-amber-400' },
} as const;

const meta = META[tier];
---

<span class={`font-mono text-[7px] tracking-[0.15em] uppercase px-1.5 py-0.5 border ${meta.cls} ${className}`}>
  {meta.label}
</span>
