---
import LineChart, { type LineSeries } from '@/components/data/LineChart.astro';
import DataList from '@/components/data/DataList.astro';
import TabIntro from '@/components/page/TabIntro.astro';
import DataRow from '@/components/data/DataRow.astro';
import DriverIdentity from '@/components/identity/DriverIdentity.astro';
import RankCell from '@/components/data/RankCell.astro';
import ShareBar from '@/features/standings/components/ShareBar.astro';
import { getTeamColor } from '@/lib/f1/teamColors';
import { championshipPoints, formatTitleOdds, titleContention, remainingSessions } from '@/lib/f1/championshipMath';
import type { DriverStanding, Race, TitleOddsResponse } from '@/types';

interface Props {
  odds: TitleOddsResponse;
  standings: DriverStanding[];
  races: Race[];
  year: number;
}

const { odds, standings, races, year } = Astro.props;
const CHART_DRIVERS = 4;
const COLUMNS = 'grid-cols-[40px_1fr_60px_140px] md:grid-cols-[40px_1fr_70px_200px_110px]';

const contention = titleContention(
  standings.map((s) => ({ id: s.driver.id, points: championshipPoints(s.stats) })),
  { year, ...remainingSessions(races) },
);
const pointsById = new Map(standings.map((s) => [s.driver.id, championshipPoints(s.stats)]));

// One round of odds is a single point per driver: nothing to chart until a second round exists.
const roundsComputed = new Set(odds.history.map((h) => h.afterRound)).size;
const showChart = roundsComputed >= 2;

const series: LineSeries[] = odds.drivers.slice(0, CHART_DRIVERS).map((d) => ({
  id: d.driver.id,
  label: d.driver.code,
  color: getTeamColor(d.driver.team.teamKey),
  points: odds.history.filter((h) => h.driverId === d.driver.id).map((h) => ({ x: h.afterRound, y: h.titleProbability })),
}));
---

<section aria-label="Title fight">
  <TabIntro
    lead={`After round ${odds.afterRound}: 10,000 simulated finishes of the remaining races, using the model's win probabilities.`}
    terms={[
      { term: 'Champ pts', meaning: 'points so far, grand prix + sprint' },
      { term: 'Title odds', meaning: 'share of simulations won' },
      { term: 'Likely final', meaning: '10th–90th percentile points' },
      { term: 'Eliminated', meaning: "can't catch the leader any more" },
    ]}
  />
  <div class={`grid gap-4 items-start ${showChart ? 'lg:grid-cols-[1fr_420px]' : ''}`}>
    <DataList
      label="Title odds"
      columns={COLUMNS}
      headers={[
        { label: 'Pos' }, { label: 'Driver' }, { label: 'Champ pts', class: 'text-right' },
        { label: 'Title odds', class: 'pl-6' }, { label: 'Likely final', class: 'text-right hidden md:block' },
      ]}
    >
      {odds.drivers.map((d, i) => {
        const alive = contention.get(d.driver.id)?.alive ?? true;
        return (
          <DataRow columns={COLUMNS} first={i === 0} accent={getTeamColor(d.driver.team.teamKey)}>
            <RankCell rank={i + 1} />
            <DriverIdentity driver={d.driver} year={year} />
            <div role="cell" class="font-mono text-sm font-bold text-right tabular-nums">{Math.round(pointsById.get(d.driver.id) ?? 0)}</div>
            <div class="pl-6">
              {alive ? (
                <ShareBar share={d.titleProbability} color={getTeamColor(d.driver.team.teamKey)} label={formatTitleOdds(d.titleProbability)} />
              ) : (
                <div role="cell" class="font-mono text-[9px] tracking-widest uppercase text-muted-foreground">Eliminated</div>
              )}
            </div>
            <div role="cell" class="font-mono text-[10px] text-muted-foreground text-right hidden md:block">{Math.round(d.pointsP10)}–{Math.round(d.pointsP90)}</div>
          </DataRow>
        );
      })}
    </DataList>
    {showChart && (
      <div class="panel p-5">
        <div class="text-[11px] text-muted-foreground mb-3">Title odds by round</div>
        <LineChart series={series} ariaLabel="Title odds after each round" yDomain={[0, 1]} formatY={(v) => `${Math.round(v * 100)}%`} xLabel="rnd" height={220} width={380} />
      </div>
    )}
  </div>
</section>
