---
import { Trophy } from 'lucide-react';
import { getTeamColor } from '@/lib/f1/teamColors';
import { championshipPoints } from '@/lib/f1/championshipMath';
import { getTeamLogo } from '@/lib/f1/teamLogos';
import { getNationalityFlag, getDriverFlagByCode, getDriverNationalityCode } from '@/lib/f1/countryFlags';
import type { DriverStanding } from '@/types';

interface Props {
  standings: DriverStanding[];
  year: number;
}

const { standings, year } = Astro.props;

function isTopPos(pos: number | null, i: number) {
  return (pos ?? i + 1) < 4;
}
function champPos(pos: number | null, i: number) {
  return pos ?? i + 1;
}

// Columns appear by priority as width allows: stats (sm), team (md), pole/races (lg), nationality (xl).
const COLUMNS = [
  'grid gap-x-4 grid-cols-[32px_minmax(0,1fr)_56px]',
  'sm:grid-cols-[40px_minmax(0,1fr)_56px_40px_40px]',
  'md:grid-cols-[40px_minmax(0,1.6fr)_minmax(0,1fr)_56px_40px_40px]',
  'lg:grid-cols-[40px_minmax(0,1.6fr)_minmax(0,1fr)_56px_40px_40px_40px_48px]',
  'xl:grid-cols-[40px_minmax(0,1.6fr)_minmax(0,1fr)_minmax(0,1.2fr)_56px_40px_40px_40px_48px]',
].join(' ');
---

<div class="border border-white/[0.06]">
  <!-- Table header -->
  <div class={`${COLUMNS} px-5 py-2.5 border-b border-white/[0.06]`} style="border-left: 3px solid transparent;">
    <div class="text-[11px] text-muted-foreground">Pos</div>
    <div class="text-[11px] text-muted-foreground">Driver</div>
    <div class="text-[11px] text-muted-foreground hidden xl:block">Nationality</div>
    <div class="text-[11px] text-muted-foreground hidden md:block">Team</div>
    <div class="text-[11px] text-muted-foreground text-right">Pts</div>
    <div class="text-[11px] text-muted-foreground text-right hidden sm:block">W</div>
    <div class="text-[11px] text-muted-foreground text-right hidden sm:block">Pod</div>
    <div class="text-[11px] text-muted-foreground text-right hidden lg:block">Pole</div>
    <div class="text-[11px] text-muted-foreground text-right hidden lg:block">Races</div>
  </div>

  {standings.map((s, i) => (
      <a
        href={`/drivers/${s.driver.id}?year=${year}`}
        class={`${COLUMNS} items-start sm:items-center px-5 py-3.5 hover:bg-white/[0.02] transition-colors duration-150 group ${i !== 0 ? 'border-t border-white/[0.04]' : ''}`}
        style={`border-left: 3px solid ${getTeamColor(s.driver.team.teamKey)};`}
      >
        <!-- Position: pt-1 aligns with name text -->
        <div class={`font-mono text-sm font-bold pt-1 sm:pt-0 ${isTopPos(s.stats.championshipPosition, i) ? 'text-[#a855f7]' : 'text-muted-foreground'}`}>
          {champPos(s.stats.championshipPosition, i) === 1 ? <Trophy size={14} /> : String(champPos(s.stats.championshipPosition, i)).padStart(2, '0')}
        </div>
        <!-- Driver -->
        <div class="flex items-start sm:items-center gap-2.5 min-w-0">
          {s.driver.headshotUrl ? (
            <img
              src={s.driver.headshotUrl}
              alt={s.driver.fullName}
              class="w-9 h-9 object-cover object-top border border-white/[0.08] shrink-0 bg-white/[0.02]"
              loading="lazy"
            />
          ) : (
            <div class="w-9 h-9 border border-white/[0.08] flex items-center justify-center shrink-0">
              <span class="font-mono text-[9px] font-bold text-muted-foreground">{s.driver.driverNumber}</span>
            </div>
          )}
          <div class="min-w-0">
            <div class="font-semibold text-sm leading-none group-hover:text-[#a855f7] transition-colors duration-150 truncate">{s.driver.fullName}</div>
            <!-- Team: own line, mobile only -->
            <div class="font-mono text-[8px] text-muted-foreground mt-1 md:hidden">{s.driver.team.name}</div>
            <!-- Stats: mobile only -->
            <div class="flex items-center gap-2 mt-0.5 sm:hidden font-mono text-[8px] text-muted-foreground/60">
              <span>{s.stats.wins}W</span>
              <span class="text-white/20">·</span>
              <span>{s.stats.podiums} Pod</span>
              <span class="text-white/20">·</span>
              <span>{s.stats.poles} Pole</span>
            </div>
          </div>
        </div>
        <!-- Nationality (sm+) -->
        <div class="hidden xl:flex items-center gap-1.5 min-w-0">
          <span class="text-sm select-none">{s.driver.nationality ? getNationalityFlag(s.driver.nationality) : getDriverFlagByCode(s.driver.code)}</span>
          <span class="font-mono text-[9px] text-muted-foreground uppercase truncate">{s.driver.nationality || getDriverNationalityCode(s.driver.code)}</span>
        </div>
        <!-- Team (md+) -->
        <div class="hidden md:flex items-center gap-2 min-w-0">
          {(() => { const logo = getTeamLogo(s.driver.team.teamKey); return logo ? (
            <img src={logo} alt={s.driver.team.name} class="h-4 w-8 object-contain shrink-0" loading="lazy" />
          ) : null; })()}
          <span class="font-mono text-[9px] text-muted-foreground truncate">{s.driver.team.name}</span>
        </div>
        <!-- Points -->
        <div class="font-mono text-xs sm:text-sm font-bold text-right tabular-nums pt-1 sm:pt-0">{Math.round(championshipPoints(s.stats))}</div>
        <!-- Wins -->
        <div class="font-mono text-sm text-right hidden sm:block">{s.stats.wins}</div>
        <!-- Podiums -->
        <div class="font-mono text-sm text-right text-muted-foreground hidden sm:block">{s.stats.podiums}</div>
        <!-- Poles -->
        <div class="font-mono text-sm text-right text-muted-foreground hidden lg:block">{s.stats.poles}</div>
        <!-- Races -->
        <div class="font-mono text-sm text-right text-muted-foreground hidden lg:block">{s.stats.racesEntered}</div>
      </a>
  ))}
</div>
