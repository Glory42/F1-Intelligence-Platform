---
import { projectTrack } from '@/features/telemetry/trackMap';
import { sectorBounds, type SectorWinner } from '@/features/telemetry/telemetryCompare';

interface Props {
  x: number[];
  y: number[];
  winners: SectorWinner[];
  colors: { a: string; b: string };
  codes: { a: string; b: string };
}

const { x, y, winners, colors, codes } = Astro.props;
const SIZE = 400;
const points = projectTrack(x, y, SIZE);
const segments = sectorBounds(points.length, winners.length).map(([from, to], k) => ({
  d: points.slice(from, to + 1).map(([px, py], i) => `${i ? 'L' : 'M'}${px},${py}`).join(''),
  color: colors[winners[k]],
  // B's sectors are dashed so the map still reads where the two colours are hard to tell apart.
  dash: winners[k] === 'b' ? '14 10' : undefined,
}));
const aWins = winners.filter((w) => w === 'a').length;
const label = `Mini-sector dominance map: ${codes.a} fastest in ${aWins} of ${winners.length} mini-sectors (solid), ${codes.b} in ${winners.length - aWins} (dashed)`;
---

<svg viewBox={`-20 -20 ${SIZE + 40} ${SIZE + 40}`} width="100%" role="img" aria-label={label} style="display:block;max-width:420px">
  {segments.map((s) => <path d={s.d} fill="none" stroke={s.color} stroke-width="8" stroke-linecap="round" stroke-dasharray={s.dash} />)}
</svg>
