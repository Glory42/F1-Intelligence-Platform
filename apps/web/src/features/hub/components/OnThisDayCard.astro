---
import { CalendarDays } from 'lucide-react';
import HubCard from './HubCard.astro';
import type { OnThisDayRace } from '@/types';

interface Props {
  races: OnThisDayRace[];
}

const { races } = Astro.props;
---

<HubCard title="On this day" id="hub-on-this-day" icon={CalendarDays}>
  <ul class="space-y-2.5">
    {races.slice(0, 4).map((r) => (
      <li>
        <a href={`/races/${r.raceId}`} class="block text-sm font-medium leading-snug hover:text-[#a855f7] transition-colors duration-150">{r.year} · {r.name}</a>
        {r.winner && <div class="font-mono text-[9px] text-muted-foreground tracking-widest uppercase mt-0.5">{r.winner.fullName}</div>}
      </li>
    ))}
  </ul>
</HubCard>
