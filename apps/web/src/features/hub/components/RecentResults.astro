---
import { CalendarDays, ChevronRight, History, MapPin } from 'lucide-react';
import { formatDate } from '@/lib/utils';
import type { Race } from '@/types';

interface Props {
  entries: Array<{ race: Race; isSprint: boolean; date: string; href: string }>;
}

const { entries: archiveEntries } = Astro.props;
---

{archiveEntries.length > 0 && (
  <section>
    <div class="flex items-center gap-3 mb-5">
      <span class="flex items-center gap-1.5 font-mono text-[9px] tracking-[0.25em] uppercase" style="color: rgba(168,85,247,0.55)"><History size={11} />./archive</span>
      <div class="h-px flex-1 bg-white/[0.05]" />
      <a href="/races" class="flex items-center gap-1 font-mono text-[8px] tracking-[0.18em] text-muted-foreground hover:text-foreground uppercase transition-colors duration-150">
        view all <ChevronRight size={10} />
      </a>
    </div>
    <h2 class="text-xl font-bold mb-5">Recent Results</h2>

    <div class="border border-white/[0.06]">
      {archiveEntries.map(({ race, isSprint, date, href }, i) => (
        <a href={href} class={`flex items-center gap-4 px-5 py-4 hover:bg-white/[0.02] transition-colors duration-150 group ${i !== 0 ? 'border-t border-white/[0.04]' : ''} ${isSprint ? 'bg-[rgba(249,115,22,0.02)]' : ''}`}>
          <span class="font-mono text-[10px] text-muted-foreground w-7 shrink-0">
            {race.roundNumber.toString().padStart(2, '0')}
          </span>
          <div class="flex-1 min-w-0">
            <div class="flex items-center gap-2">
              <div class={`font-medium text-sm truncate transition-colors duration-150 ${isSprint ? 'group-hover:text-orange-400' : 'group-hover:text-[#a855f7]'}`}>{race.name}</div>
              {isSprint && (
                <span class="shrink-0 font-mono text-[7px] tracking-[0.15em] uppercase px-1.5 py-0.5 border border-orange-500/35 text-orange-400/75 hidden sm:inline">sprint</span>
              )}
            </div>
            <div class="flex items-center gap-1 font-mono text-[9px] text-muted-foreground mt-0.5 truncate">
              <MapPin size={9} />{race.circuit.city}, {race.circuit.country}
            </div>
          </div>
          <span class="flex items-center gap-1 font-mono text-[9px] text-muted-foreground sm:flex shrink-0"><CalendarDays size={10} />{formatDate(date)}</span>
          <span class={`flex items-center gap-1 font-mono text-[9px] tracking-[0.12em] uppercase shrink-0 transition-colors duration-150 ${isSprint ? 'text-orange-400/60 group-hover:text-orange-400' : 'text-muted-foreground group-hover:text-[#a855f7]'}`}>
            results <ChevronRight size={10} />
          </span>
        </a>
      ))}
    </div>
  </section>
)}
