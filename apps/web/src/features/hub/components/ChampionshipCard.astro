---
import { Trophy } from 'lucide-react';
import HubCard from './HubCard.astro';
import { formatTitleOdds } from '@/lib/championshipMath';
import { getTeamColor } from '@/lib/teamColors';
import type { TitleOddsResponse } from '@/types';

interface Props {
  odds: TitleOddsResponse;
}

const { odds } = Astro.props;
const top = odds.drivers.slice(0, 3);
---

<HubCard title="Championship" id="hub-championship" icon={Trophy} href="/drivers">
  <div class="font-semibold text-sm leading-snug mb-3 group-hover:text-[#a855f7] transition-colors duration-150">Title odds · after R{odds.afterRound}</div>
  <ol class="space-y-2">
    {top.map((d) => (
      <li class="flex items-center gap-3">
        <span class="font-mono text-[10px] font-bold tracking-widest w-9">{d.driver.code}</span>
        <span class="flex-1 h-1.5 bg-white/[0.06] overflow-hidden"><span class="block h-full bar-fill" style={`width:${Math.round(d.titleProbability * 100)}%; background:${getTeamColor(d.driver.team.teamKey)}`} /></span>
        <span class="font-mono text-[10px] font-bold w-10 text-right">{formatTitleOdds(d.titleProbability)}</span>
      </li>
    ))}
  </ol>
</HubCard>
