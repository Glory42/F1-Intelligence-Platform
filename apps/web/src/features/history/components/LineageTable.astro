---
import { Cpu } from 'lucide-react';
import SectionKicker from '@/components/shared/SectionKicker.astro';
import DataList from '@/components/shared/DataList.astro';
import DataRow from '@/components/shared/DataRow.astro';
import F1dbCredit from './F1dbCredit.astro';
import type { TeamHistory } from '@/types';

interface Props {
  history: TeamHistory;
  color: string;
}

const { history, color } = Astro.props;
const COLUMNS = 'grid-cols-[60px_1fr_1fr]';
---

{history.seasons.length > 0 && (
  <section>
    <SectionKicker icon={Cpu} label={`./lineage · ${history.constructor.raceWins} wins · ${history.constructor.championships} titles`} />
    <DataList label="Chassis and engines" columns={COLUMNS} headers={[{ label: 'Season' }, { label: 'Chassis' }, { label: 'Power unit' }]}>
      {history.seasons.map((s, i) => (
        <DataRow columns={COLUMNS} first={i === 0} accent={i === 0 ? color : 'transparent'}>
          <div role="cell" class="font-mono text-[10px] text-muted-foreground">{s.year}</div>
          <div role="cell" class="font-semibold text-sm">{s.chassis ?? '—'}</div>
          <div role="cell" class="font-mono text-[10px] text-muted-foreground">{s.engine ?? '—'}</div>
        </DataRow>
      ))}
    </DataList>
    <div class="mt-3"><F1dbCredit /></div>
  </section>
)}
