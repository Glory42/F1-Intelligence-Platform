{
  "name": "api",
  "main": "src/main.ts",
  "type": "module",
  "private": true,
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "bun test --timeout 30000",
    "test:unit": "bun test tests/unit",
    "test:integration": "bun test tests/integration --timeout 30000",
    "test:db:up": "docker compose -f ../../docker-compose.test.yml up -d --wait && NODE_ENV=test DATABASE_URL=postgres://f1:f1@localhost:4445/f1_test bun --env-file=.env.test run src/db/migrate.ts",
    "test:db:down": "docker compose -f ../../docker-compose.test.yml down",
    "db:generate": "drizzle-kit generate",
    "db:push": "drizzle-kit push",
    "db:migrate": "bun run src/db/migrate.ts",
    "db:studio": "drizzle-kit studio",
    "db:seed": "bun run src/db/seed.ts"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20260529.1",
    "@types/bun": "latest",
    "@types/node": "^25.9.1",
    "drizzle-kit": "^0.31.10",
    "eslint": "^10.9.1",
    "typescript-eslint": "^8.68.0",
    "wrangler": "^4.95.0"
  },
  "peerDependencies": {
    "typescript": "^5"
  },
  "dependencies": {
    "@neondatabase/serverless": "^1.1.0",
    "drizzle-orm": "^0.45.2",
    "hono": "^4.12.23",
    "zod": "^4.4.3"
  }
}
