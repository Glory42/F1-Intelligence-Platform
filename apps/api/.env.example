##Database
# Local dev: docker-compose.dev.yml through its Neon HTTP proxy (wrangler dev reads .dev.vars):
#   DATABASE_URL=postgres://f1:f1@localhost:4446/f1_dev
#   NEON_FETCH_ENDPOINT=http://localhost:4446/sql
DATABASE_URL=
# Integration tests use apps/api/.env.test (local docker Postgres, see docker-compose.test.yml),
# which overrides this file under `bun test`: they never run against Neon.

#CloudflareR2
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=
R2_PUBLIC_URL=
